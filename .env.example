# Copy to .env and replace the placeholders with unique random values.
# Use hexadecimal values (for example: openssl rand -hex 32) to avoid
# Compose interpolation issues with special characters.
DB_PASSWORD=replace-with-a-unique-random-value
REDIS_PASSWORD=replace-with-a-unique-random-value
ELASTIC_PASSWORD=replace-with-a-unique-random-value

# Required only when enabling the optional Kibana service.
KIBANA_PASSWORD=replace-with-a-unique-random-value

# Local-only published ports; assessment override binds them to loopback.
FRONTEND_PORT=80
PLATFORM_PORT=8090

# Resource and dependency versions.
ES_MEM_LIMIT=1g
PGSQL_VERSION=18.3
STACK_VERSION=8.18.0
ES_CLUSTER_NAME=elasticsearch
ES_LICENSE=basic
